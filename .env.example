# ManyDoors AI — copy to .env.local for local dev

# Contact (all forms → info@manydoorsai.com)
VITE_PM_SUPPORT_EMAIL=info@manydoorsai.com

# EmailJS — optional; without these, contact form opens mailto:
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional self-serve scheduling link (Calendly / Cal.com / HubSpot).
# When set, "Book a demo" CTAs open this URL; otherwise they open the contact widget.
VITE_PM_BOOKING_URL=

# Site
VITE_PM_BASE_PATH=/
VITE_PM_SITE_URL=https://www.manydoorsai.com
VITE_PM_CHAT_URL=https://us-central1-property-managment-a5ed3.cloudfunctions.net/pmGatewayChat

# PM Firebase (property-managment-a5ed3) — public web config (see src/config/firebasePublic.js)
VITE_PM_FIREBASE_API_KEY=AIzaSyAuYn4nm9jTIcdFeNStmLF_Ky8qgwe4R2M
VITE_PM_FIREBASE_AUTH_DOMAIN=property-managment-a5ed3.firebaseapp.com
VITE_PM_FIREBASE_PROJECT_ID=property-managment-a5ed3
VITE_PM_FIREBASE_STORAGE_BUCKET=property-managment-a5ed3.firebasestorage.app
